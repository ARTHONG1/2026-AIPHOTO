# Copy to .env.local and fill in. Never commit real values.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Image model (defaults shown). Pro at 1K usually takes 25-35 s, longer when the service is busy.
# 2K is sharper but about twice as slow.
PHOTOBOOTH_IMAGE_MODEL=gemini-3-pro-image
PHOTOBOOTH_IMAGE_SIZE=1K
# Optional model to retry with when the main model returns an error (empty = Pro only).
PHOTOBOOTH_FALLBACK_MODEL=

# 0 = keep the AI-drawn face (skip the local face transfer)
PHOTOBOOTH_FACE_TRANSFER=

# QR delivery does NOT upload images. For reliable PC Wi-Fi -> phone LTE
# delivery, configure a TURN relay. Keep credentials out of git; prefer expiring credentials.
PHOTOBOOTH_TURN_URLS=
PHOTOBOOTH_TURN_USERNAME=
PHOTOBOOTH_TURN_CREDENTIAL=

# 1 = skip Vertex AI and return the original photo (rehearsal mode)
PHOTOBOOTH_MOCK_AI=
